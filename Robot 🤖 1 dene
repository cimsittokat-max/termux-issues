@app.route('/')
def index():
    return render_template_string(HTML)

@app.route('/video')
def video():
    return Response(gen_frames(),
        mimetype='multipart/x-mixed-replace; boundary=frame')

@app.route('/cmd', methods=['POST'])
def cmd():
    global head_angle, arm_angle
    c = request.form['cmd']

    if c == "HEAD_L":
        head_angle = max(0, head_angle - 10)
        move_head(head_angle)

    if c == "HEAD_R":
        head_angle = min(180, head_angle + 10)
        move_head(head_angle)

    if c == "ARM_UP":
        arm_angle = min(180, arm_angle + 15)
        move_arm(arm_angle)

    if c == "ARM_DOWN":
        arm_angle = max(0, arm_angle - 15)
        move_arm(arm_angle)

    if c == "HELLO":
        speak("Merhaba ben insansı robotum")

    return ('',204)

