# ================== ARDUINO ==================
board = Arduino('COM3')   # Linux: /dev/ttyUSB0
time.sleep(2)

HEAD = 9
ARM  = 10
board.digital[HEAD].mode = SERVO
board.digital[ARM].mode  = SERVO

head_angle = 90
arm_angle  = 90

def move_head(a):
    board.digital[HEAD].write(a)

def move_arm(a):
    board.digital[ARM].write(a)

# ================== SES ==================
def speak(text):
    os.system(f'espeak "{text}"')

# ================== SES TANIMA ==================
r = sr.Recognizer()

def voice_loop():
    global arm_angle
    while True:
        try:
            with sr.Microphone() as source:
                audio = r.listen(source, timeout=5)
            text = r.recognize_google(audio, language="tr-TR").lower()
            print("Ses:", text)

            if "merhaba" in text:
                speak("Merhaba insan")

            if "kolu kaldır" in text:
                arm_angle = min(180, arm_angle + 20)
                move_arm(arm_angle)

            if "kolu indir" in text:
                arm_angle = max(0, arm_angle - 20)
                move_arm(arm_angle)

        except:
            pass

# ================== KAMERA + YÜZ ==================
cam = cv2.VideoCapture(0)
face = cv2.CascadeClassifier(
    cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
)

def gen_frames():
    global head_angle
    while True:
        ret, frame = cam.read()
        if not ret:
            break

        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        faces = face.detectMultiScale(gray, 1.3, 5)

        for (x,y,w,h) in faces:
            cx = x + w//2
            if cx < 200:
                head_angle = min(180, head_angle + 2)
            elif cx > 440:
                head_angle = max(0, head_angle - 2)
            move_head(head_angle)

            cv2.rectangle(frame,(x,y),(x+w,y+h),(0,255,0),2)

        _, buffer = cv2.imencode('.jpg', frame)
        frame = buffer.tobytes()

        yield (b'--frame\r\n'
               b'Content-Type: image/jpeg\r\n\r\n' + frame + b'\r\n')

